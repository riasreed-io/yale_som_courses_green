# Copy to .env and fill in. Never commit the real .env.

# Portkey gateway key for the course agent.
PORTKEY_API_KEY=your-portkey-api-key-here

# Database. Leave unset locally to use data/yale_som.db (SQLite).
# In production set the Supabase connection string:
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Signs session tokens. Unset means a random key per process, which logs
# everyone out on restart — set a long random string in production.
# SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API. Defaults to * for local dev.
# ALLOWED_ORIGINS=https://yale-som-courses-web.onrender.com
